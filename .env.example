# Server
PORT=3001

JWT_SECRET=1234567890

# TiDB Cloud (MySQL-compatible)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=mtb-cluster

DIR_PATH=/MTB_WGS_cluster_analysis

# Nextflow requires Java 17+.
# If your server has a system-wide JAVA_HOME pointing to Java 8, set this to a Java 17+ home,
# e.g. /usr/lib/jvm/java-17-openjdk-amd64 or /Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home
PIPELINE_JAVA_HOME=

# If `mamba`/`conda` is not in the service PATH (e.g. installed under another user like "gdata"),
# set this to the directory containing the binaries, e.g. /home/gdata/mambaforge/bin
PIPELINE_CONDA_BIN_DIR=

# Queue worker polling interval (milliseconds)
PIPELINE_QUEUE_POLL_MS=5000

# Dashboard/TXT data source
# Expected file location:
#   <DIR_PATH>/preexisting_db/vYYYYMMDD.xx/metadata/metadata.txt
# (Fallback supported for older versions: <DIR_PATH>/preexisting_db/vYYYYMMDD.xx/metadata.txt)
# The API will automatically pick the latest folder by date and .xx