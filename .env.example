# Server
PORT=3001
NODE_ENV=development

# TiDB Cloud (MySQL-compatible)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=mtb-cluster

# TLS/SSL (recommended for TiDB Cloud)
# If DB_HOST contains "tidbcloud.com", SSL is enabled by default.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional: provide CA certificate if your environment requires it
# DB_SSL_CA_FILE=/absolute/path/to/tidb-ca.pem
# or inline PEM with \n escapes:
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----"

# Uploads (optional)
# UPLOAD_DIR=/tmp/uploads
